# ==============================================================================
# PLAYSTATION NETWORK STUDY APP - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env files to git (add to .gitignore)
# - Use different values for development vs production
# - In production, use AWS Secrets Manager or similar
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port the GraphQL server listens on
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens
# In production: Use a long, random string (32+ characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# How long tokens are valid (e.g., "1h", "7d", "30d")
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Format: redis://[username:password@]host:port
# Local development (Docker)
REDIS_URL=redis://localhost:6379

# Production example (AWS ElastiCache):
# REDIS_URL=redis://my-cluster.abc123.0001.usw2.cache.amazonaws.com:6379

# Session expiry in seconds (3600 = 1 hour)
SESSION_TTL=3600

# Presence expiry in seconds (300 = 5 minutes)
# If user doesn't send heartbeat within this time, they appear offline
PRESENCE_TTL=300

# ------------------------------------------------------------------------------
# KAFKA CONFIGURATION
# ------------------------------------------------------------------------------
# Kafka broker address
# Local development (Docker)
KAFKA_BROKERS=localhost:9092

# Production example (AWS MSK):
# KAFKA_BROKERS=b-1.mycluster.abc123.kafka.us-west-2.amazonaws.com:9092

# Consumer group ID for this service
KAFKA_GROUP_ID=psn-social-service

# ------------------------------------------------------------------------------
# DYNAMODB CONFIGURATION
# ------------------------------------------------------------------------------
# Local DynamoDB endpoint (Docker)
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Region (for production or local with AWS credentials)
AWS_REGION=us-west-2

# Local development doesn't need real AWS credentials
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Allowed origins for cross-origin requests
# In production: Use your actual frontend domain
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
# Maximum requests per minute per user
RATE_LIMIT_MAX=100

# Window size in milliseconds
RATE_LIMIT_WINDOW=60000
